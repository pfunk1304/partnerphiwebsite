---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  class?: string;
}
const { href, variant = 'primary', class: className } = Astro.props;
const styles = {
  primary: 'bg-gold text-ink hover:bg-gold-bright',
  ghost: 'border border-line text-paper hover:border-gold hover:text-gold',
};
---
<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-sm px-f21 py-f13 text-base font-bold no-underline transition-colors',
    styles[variant],
    className,
  ]}
>
  <slot />
</a>
